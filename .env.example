QDRANT_URL=http://127.0.0.1:6334 # Endpoint gRPC de Qdrant
QDRANT_HTTP_URL=http://127.0.0.1:6333 # Endpoint HTTP de Qdrant
QDRANT_ALIAS=rag_active # Alias del índice activo
SOURCE_DIR=./manuales # Carpeta de documentos fuente
TEI_URL=http://127.0.0.1:8080 # Endpoint gRPC de embeddings
EMBEDDING_MODEL=BAAI/bge-m3 # Modelo para generar embeddings
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181 # Revisión fija del modelo
EMBEDDING_DIMENSION=1024 # Dimensión de los vectores
OPENAI_MODEL=gpt-5-mini # Modelo para generar respuestas
OPENAI_API_KEY=CHANGE_ME # Clave de API de OpenAI
CHUNK_TARGET_TOKENS=450 # Tokens objetivo por fragmento
CHUNK_MAX_TOKENS=600 # Tokens máximos por fragmento
CHUNK_OVERLAP_TOKENS=60 # Tokens compartidos entre fragmentos
MAX_FILE_BYTES=10485760 # Tamaño máximo por archivo (bytes)
TOP_K=5 # Cantidad de resultados recuperados
