# Cada variable indica si es obligatoria:
#   [obligatoria]            la API no puede cumplir esa función sin ella
#   [obligatoria: Compose]   `podman compose` no arranca si falta (compose.yaml usa `:?`)
#   [opcional: valor]        valor que usa la API si se omite
# Las variables de entorno tienen prioridad sobre .env. Las rutas relativas parten del
# directorio de ejecución. Un valor inválido impide arrancar la API.

# API Rust
HTTP_BIND=0.0.0.0:3000 # [opcional: 0.0.0.0:3000] Dirección de escucha de la API
TOP_K=5 # [opcional: 5] Máximo de fragmentos enviados al modelo (1–50)

# Logs: cargo run usa texto y rag=debug; --release usa JSON y rag=info
# RUST_LOG=rag=debug # [opcional] Cambia el detalle, conservando el formato de la compilación

# Qdrant
QDRANT_URL=http://127.0.0.1:6334 # [opcional: http://127.0.0.1:6334] Endpoint gRPC de Qdrant
QDRANT_ALIAS=rag_docling # [opcional: rag_docling] Alias del índice activo

# TEI y modelo de embeddings
TEI_URL=http://127.0.0.1:8080 # [opcional: http://127.0.0.1:8080] Endpoint gRPC de embeddings
EMBEDDING_MODEL=BAAI/bge-m3 # [obligatoria: Compose] Modelo para generar embeddings; la API usa BAAI/bge-m3 si se omite
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181 # [obligatoria: Compose] Revisión fija del modelo; la API la exige si TEI no informa su revisión
EMBEDDING_DIMENSION=1024 # [opcional: 1024] Dimensión de los vectores

# OpenAI
OPENAI_MODEL=gpt-5-mini # [opcional: gpt-5-mini] Modelo para generar respuestas
OPENAI_API_KEY=CHANGE_ME # [obligatoria] Clave de API de OpenAI; solo se usa para responder con evidencia; CHANGE_ME cuenta como no configurada

# Ingesta en la API Rust
CHUNK_TARGET_TOKENS=512 # [opcional: 512] Presupuesto de Docling; TEI informa el límite real de aceptación
MAX_FILE_BYTES=10485760 # [opcional: 10485760] Tamaño máximo por documento JSONL (bytes)
DOCUMENTS_ROOT=corpus # [opcional: manuales] Raíz de originales; debe existir. Selección por rutas relativas, sin copias persistentes
INGESTIONS_DB_PATH=data/ingestions.sqlite # [opcional: data/ingestions.sqlite] Catálogo de identidades, cola e historial; conservar junto a los originales
INGESTIONS_TEMP_ROOT=data/tmp # [opcional: data/tmp] Directorios temporales por intento de ingesta

# Docling: cliente HTTP de la API Rust
DOCLING_URL=http://127.0.0.1:5001/ # [opcional: http://127.0.0.1:5001/] API HTTP de Docling, sin credenciales, query ni fragmento
DOCLING_MAX_DOWNLOAD_BYTES=33554432 # [opcional: 33554432] 32 MiB de ZIP comprimido
DOCLING_MAX_EXPANDED_BYTES=134217728 # [opcional: 134217728] 128 MiB expandidos por ZIP
DOCLING_MAX_ARCHIVE_ENTRIES=200 # [opcional: 200] Máximo de entradas del ZIP
DOCLING_REQUEST_TIMEOUT_SECS=120 # [opcional: 120] Timeout de cada HTTP; el worker reintenta el documento
DOCLING_CONVERSION_TIMEOUT_SECS=1800 # [opcional: 1800] Espera total por tarea; independiente del timeout de cada HTTP

# Opciones de conversión enviadas por la API Rust a Docling
DOCLING_IMAGE_EXPORT_MODE=referenced # [opcional: referenced] referenced | embedded | placeholder
DOCLING_DO_OCR=true # [opcional: true] true | false; independiente del modo de exportación de imágenes
DOCLING_OCR_PRESET=auto # [opcional: auto] auto, easyocr, tesseract según disponibilidad; no puede estar vacío si DOCLING_DO_OCR=true

# Docling Serve: configuración del contenedor
DOCLING_DEVICE=cpu # [obligatoria: Compose] cpu por defecto, cuda para GPU NVIDIA. Comprobar que `nvidia-ctk cdi list` muestra `nvidia.com/gpu=all`.
DOCLING_SERVE_ENABLE_UI=true # [obligatoria: Compose] Interfaz web de Docling
DOCLING_SERVE_ENG_KIND=local # [obligatoria: Compose] Motor de procesamiento de Docling
DOCLING_SERVE_MAX_SOURCES_PER_REQUEST=20 # [obligatoria: Compose] Límite de Docling; la API envía un archivo por tarea, no limita el lote
DOCLING_SERVE_MAX_FILE_SIZE=52428800 # [obligatoria: Compose] 50 MiB por documento original; la API usa el mismo límite (52428800 si se omite)
DOCLING_SERVE_MAX_NUM_PAGES=200 # [obligatoria: Compose] Máximo de páginas por documento
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=false # [obligatoria: Compose] Permitir servicios remotos durante la conversión
