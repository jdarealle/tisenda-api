# API Rust
HTTP_BIND=0.0.0.0:3000 # API Rust
TOP_K=5 # Máximo de fragmentos enviados al modelo (1–50)

# Logs: cargo run usa texto y rag=debug; --release usa JSON y rag=info
# RUST_LOG=rag=debug # Opcional: cambia el detalle, conservando el formato de la compilación

# Qdrant
QDRANT_URL=http://127.0.0.1:6334 # Endpoint gRPC de Qdrant
QDRANT_ALIAS=rag_docling # Alias del índice activo

# TEI y modelo de embeddings
TEI_URL=http://127.0.0.1:8080 # Endpoint gRPC de embeddings
EMBEDDING_MODEL=BAAI/bge-m3 # Modelo para generar embeddings
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181 # Revisión fija del modelo
EMBEDDING_DIMENSION=1024 # Dimensión de los vectores

# OpenAI
OPENAI_MODEL=gpt-5-mini # Modelo para generar respuestas
OPENAI_API_KEY=CHANGE_ME # Clave de API de OpenAI

# Ingesta en la API Rust
CHUNK_TARGET_TOKENS=512 # Presupuesto de Docling; TEI informa el límite real de aceptación
MAX_FILE_BYTES=10485760 # Tamaño máximo por documento JSONL (bytes)
DOCUMENTS_ROOT=corpus # Raíz de originales; selección por rutas relativas, sin copias persistentes

# Docling: cliente HTTP de la API Rust
DOCLING_URL=http://127.0.0.1:5001/ # API HTTP de Docling
DOCLING_MAX_DOWNLOAD_BYTES=33554432 # 32 MiB de ZIP comprimido
DOCLING_MAX_EXPANDED_BYTES=134217728 # 128 MiB expandidos por ZIP
DOCLING_MAX_ARCHIVE_ENTRIES=200 # Máximo de entradas del ZIP
DOCLING_REQUEST_TIMEOUT_SECS=120 # Una descarga, sin reintentos
DOCLING_CONVERSION_TIMEOUT_SECS=1800 # Espera total por tarea; independiente del timeout de cada HTTP

# Opciones de conversión enviadas por la API Rust a Docling
DOCLING_IMAGE_EXPORT_MODE=referenced # referenced | embedded | placeholder
DOCLING_DO_OCR=true # true | false; independiente del modo de exportación de imágenes
DOCLING_OCR_PRESET=auto # auto, easyocr, tesseract según disponibilidad; omitido si do_ocr=false

# Docling Serve: configuración del contenedor
DOCLING_DEVICE=cpu # cpu por defecto, cuda para GPU NVIDIA. Comprobar que `nvidia-ctk cdi list` muestra `nvidia.com/gpu=all`.
DOCLING_SERVE_ENABLE_UI=true # Interfaz web de Docling
DOCLING_SERVE_ENG_KIND=local # Motor de procesamiento de Docling
DOCLING_SERVE_MAX_SOURCES_PER_REQUEST=20 # Límite de Docling; la API envía un archivo por tarea, no limita el lote
DOCLING_SERVE_MAX_FILE_SIZE=52428800 # 50 MiB por documento original
DOCLING_SERVE_MAX_NUM_PAGES=200 # Máximo de páginas por documento
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=false # Permitir servicios remotos durante la conversión
